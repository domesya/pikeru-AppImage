#!/bin/sh
#
#  This hook is meant to install pikeru into the system its being ran on
#


# _portal_bin is a special portal binary that's needed for the dbus service(?)
_portal_bin="${BINDIR}/xdg-desktop-portal-pikeru"
_dot_portal="${DATADIR}/xdg-desktop-portal/portals/pikeru.portal"
_pikeru_dir="${DATADIR}/xdg-desktop-portal-pikeru"
_config_file="${CONFIGDIR}/xdg-desktop-portal-pikeru/config"
_portals_conf="${CONFIGDIR}/xdg-desktop-portal/portals.conf"
_systemd_service_file="${CONFIGDIR}/systemd/user/xdg-desktop-portal-pikeru.service"
_dbus_service_file="${DATADIR}/dbus-1/services/org.freedesktop.impl.portal.desktop.pikeru.service"
_state_file="${STATEDIR}/.pikeru-installed"

_sanity_check() {
  if is_cmd "ln" "cp" "mkdir" "pikeru"; then
    :
  else
    err_msg "we're screwed"
    return 1
  fi
}

_prepare() {
  case "$1" in
    all)
      mkdir -p "${BINDIR}"
      mkdir -p "${STATEDIR}"
      mkdir -p "${CONFIGDIR}/systemd/user"
      mkdir -p "${DATADIR}/dbus-1/services"
      mkdir -p "${DATADIR}/xdg-desktop-portal/portals"
      ;;
    state)
      mkdir -p "${STATEDIR}"
      ;;
  esac
}

_pikeru_install() {
  
  ln -sf "${BINDIR}/pikeru"   "$_portal_bin"
  cp "${APPDIR}/share/xdg-desktop-portal/portals/pikeru.portal"  "$_dot_portal"
  cp -r "${APPDIR}/share/xdg-desktop-portal-pikeru/"  "$_pikeru_dir"
  
   cat > "$_systemd_service_file" <<-EOF
[Unit]
Description=Portal service (Pikeru implementation)
Before=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.pikeru
ExecStart=%h/.local/bin/xdg-desktop-portal-pikeru

[Install]
WantedBy=default.target
EOF

# Assuming pikeru AppImage is in ~/.local/bin/pikeru

  cat > "$_dbus_service_file" <<-EOF
[D-BUS Service]
Name=org.freedesktop.impl.portal.desktop.pikeru
Exec=%h/.local/bin/pikeru
SystemdService=xdg-desktop-portal-pikeru.service
EOF
    
}


_change_config() { 
  if [ -f "$_portals_conf" ]; then
    sed -i 's|^\(org\.freedesktop\.impl\.portal\.FileChooser=\).*|\1pikeru|' "$_portals_conf" || :
  fi
}


_main_func() {
  if [ ! -f "$_state_file" ]; then
    notify -di "Please put a symlink to pikeru AppImage(or the appimage file itself) in ${BINDIR}/pikeru if you want the appimage install hook to work.";
    if notify -dq "$(cat <<-EOF
Do you wish to attempt to integrate pikeru into the system?
The following files/directories would be installed/altered:
    
* $_portal_bin
* $_dot_portal
* $_pikeru_dir
* $_portals_conf
* $_systemd_service_file
* $_dbus_service_file
* $_state_file    

EOF
    )"; then
      _prepare all
      _pikeru_install
      _change_config
      : > "$_state_file"
    else
      _prepare state
      : > "$_state_file"
    fi
  fi
}

_sanity_check
_main_func 

