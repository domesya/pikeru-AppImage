#!/bin/sh
#
#  This hook is meant to install pikeru into the system its being ran on
#

# _portal_bin is a special portal binary that's needed for the dbus service(?)
_portal_bin="${BINDIR}/xdg-desktop-portal-pikeru"
_dot_portal="${DATADIR}/xdg-desktop-portal/portals/pikeru.portal"
_pikeru_dir="${DATADIR}/xdg-desktop-portal-pikeru"
_config_file="${CONFIGDIR}/xdg-desktop-portal-pikeru/config"
_portals_conf="${CONFIGDIR}/xdg-desktop-portal/portals.conf"
_service_file="${CONFIGDIR}/systemd/user/xdg-desktop-portal-pikeru.service"

_pikeru_install() {
    mkdir -p "${BINDIR}"
    mkdir -p "${DATADIR}/xdg-desktop-portal/portals"
    mkdir -p "${CONFIGDIR}/systemd/user"
    
    cp "${APPDIR}/shared/bin/xdg-desktop-portal-pikeru"   "$_portal_bin"
    cp "${APPDIR}/share/xdg-desktop-portal/portals/pikeru.portal"  "$_dot_portal"
    cp -r "${APPDIR}/share/xdg-desktop-portal-pikeru/"  "$_pikeru_dir"

    cat > "$_service_file" <<-EOF
[Unit]
Description=Portal service (Pikeru implementation)
Before=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.pikeru
ExecStart=%h/.local/bin/xdg-desktop-portal-pikeru

[Install]
WantedBy=default.target
EOF
    
}


_change_config() {
  # Assuming that pikeru will be in ~/.local/bin/pikeru
#   if [ -f "$_config_file" ]; then
#         
#   fi
 
  if [ -f "$_portals_conf" ]; then
    sed -i 's|^\(org\.freedesktop\.impl\.portal\.FileChooser=\).*|\1pikeru|' "$_portals_conf" || :
  fi
}


_main_func() {
    
  if [ ! -f "$_portal_bin" ] \
  || [ ! -f "$_dot_portal" ] \
  || [ ! -d "$_pikeru_dir" ] \
  || [ ! -f "$_service_file" ]; then
    zenity --width 500 --question --text "$(cat <<-EOF
Do you wish to attempt to integrate pikeru into the system?
The following files/directories would be installed/altered:
    
* $_portal_bin
* $_dot_portal
* $_pikeru_dir
* $_portals_conf
* $_service_file
    
EOF
    )" || return 1
    _pikeru_install
    _change_config
  fi
  
}

_main_func 
